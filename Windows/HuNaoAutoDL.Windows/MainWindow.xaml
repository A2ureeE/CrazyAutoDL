<Window x:Class="HuNaoAutoDL.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="胡闹AutoDL · Windows" Width="1120" Height="720" MinWidth="900" MinHeight="560" Background="#10141E" Foreground="#F2F4F8" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#171D2A" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="胡闹AutoDL" FontSize="24" FontWeight="Bold"/><TextBlock Text="AutoDL 实例监控与自动开机" Foreground="#AAB4C8"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="未连接" VerticalAlignment="Center"/><Button Content="刷新" Click="Refresh_Click"/><Button Content="退出登录" Click="Logout_Click"/></StackPanel></Grid></Border>
  <TabControl x:Name="Tabs" Margin="14" Background="#171D2A" Foreground="#111">
   <TabItem Header="监控台"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="监控状态" FontSize="20" FontWeight="Bold"/><UniformGrid Columns="3" Margin="0,10"><Border Background="#202A3A" Padding="14" Margin="4"><StackPanel><TextBlock Text="监控目标" Foreground="#AAB4C8"/><TextBlock x:Name="TargetText" FontSize="18"/></StackPanel></Border><Border Background="#202A3A" Padding="14" Margin="4"><StackPanel><TextBlock Text="GPU 空闲" Foreground="#AAB4C8"/><TextBlock x:Name="GpuText" FontSize="18"/></StackPanel></Border><Border Background="#202A3A" Padding="14" Margin="4"><StackPanel><TextBlock Text="可用余额" Foreground="#AAB4C8"/><TextBlock x:Name="BalanceText" FontSize="18"/></StackPanel></Border></UniformGrid><Border Background="#202A3A" Padding="14" Margin="4"><StackPanel><DockPanel><TextBlock Text="自动开机" FontSize="18"/><ToggleButton x:Name="AutoStartToggle" DockPanel.Dock="Right" Content="启用" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/></DockPanel><TextBlock Text="发现目标主机有空闲 GPU 时自动发送开机指令。" Foreground="#AAB4C8"/><TextBlock x:Name="LastUpdatedText"/></StackPanel></Border><TextBlock Text="最近活动" FontSize="18" FontWeight="Bold" Margin="4,18,4,4"/><ListView x:Name="ActivityList" Height="210" Background="#202A3A" Foreground="#F2F4F8"><ListView.View><GridView><GridViewColumn Header="时间" DisplayMemberBinding="{Binding Date, StringFormat=MM-dd HH:mm:ss}" Width="140"/><GridViewColumn Header="事件" DisplayMemberBinding="{Binding Title}" Width="180"/><GridViewColumn Header="详情" DisplayMemberBinding="{Binding Detail}" Width="650"/></GridView></ListView.View></ListView></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="我的实例"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="InstancesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Instance_SelectionChanged" Background="#202A3A" Foreground="#111"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="GPU" Binding="{Binding GpuName}" Width="160"/><DataGridTextColumn Header="地区" Binding="{Binding DisplayRegion}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="90"/><DataGridTextColumn Header="内存余量" Binding="{Binding MemoryFreeLabel}" Width="120"/><DataGridTextColumn Header="存储余量" Binding="{Binding StorageFreeLabel}" Width="120"/><DataGridTextColumn Header="释放时间" Binding="{Binding ReleaseAt, StringFormat=MM-dd HH:mm}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="监控此实例" Click="SelectMonitor_Click"/><Button Content="开机/关机" Click="Power_Click"/><Button Content="释放（打开网页确认）" Click="Release_Click"/></StackPanel></Grid></TabItem>
   <TabItem Header="账单"><StackPanel Margin="16"><TextBlock Text="账单看板" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="BillingSummary" FontSize="16" Margin="4,12"/><DataGrid x:Name="BillsGrid" AutoGenerateColumns="False" Height="480" IsReadOnly="True" Background="#202A3A" Foreground="#111"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="金额" Binding="{Binding SignedAmountLabel}" Width="120"/><DataGridTextColumn Header="GPU" Binding="{Binding GpuType}" Width="180"/><DataGridTextColumn Header="地区" Binding="{Binding RegionName}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="设置"><StackPanel Margin="16"><TextBlock Text="账户连接" FontSize="20" FontWeight="Bold"/><TextBlock Text="Token（保存在 %LOCALAPPDATA%\\HuNaoAutoDL\\session.token）" Foreground="#AAB4C8"/><Button Content="打开 AutoDL 登录页" Click="WebLogin_Click" HorizontalAlignment="Left"/><PasswordBox x:Name="TokenBox" Margin="4" Height="34"/><Button Content="使用 Token 连接并开始监控" Click="Login_Click" HorizontalAlignment="Left"/><Separator Margin="4,18"/><TextBlock Text="演示模式：启动参数 --demo 可离线浏览完整界面" Foreground="#AAB4C8"/><TextBlock Text="监控刷新间隔（秒，8-120）"/><TextBox x:Name="PollIntervalBox" Text="15" Width="120" HorizontalAlignment="Left"/><TextBlock Text="低余额提醒阈值（元）"/><TextBox x:Name="BalanceThresholdBox" Text="20" Width="120" HorizontalAlignment="Left"/><Button Content="应用设置" Click="ApplySettings_Click" HorizontalAlignment="Left"/><TextBlock x:Name="ErrorText" Foreground="#FF8A8A" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
